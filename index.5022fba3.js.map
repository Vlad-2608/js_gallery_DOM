"use strict";
document.addEventListener("DOMContentLoaded", function() {
    var thumbsContainer = document.getElementById("thumbs");
    var largeImg = document.getElementById("largeImg");
    thumbsContainer.addEventListener("click", function(evt) {
        var target = evt.target;
        var anchorElement = target.closest("a");
        if (anchorElement && anchorElement.hasAttribute("href")) {
            evt.preventDefault();
            var newImageSrc = anchorElement.getAttribute("href");
            largeImg.src = newImageSrc;
            largeImg.alt = anchorElement.getAttribute("title");
        }
    });
});

